# Copy this file to .env and fill it. NEVER commit .env.
# Set the same values in Railway -> Variables for the deployed service.

# LLM provider: base44 | openai | anthropic
LLM_PROVIDER=base44
# Model id. Base44 valid set: automatic, gpt_5_mini, gemini_3_flash, gpt_5_4, gpt_5_6_sol,
# gpt_5_6_luna, gemini_3_1_pro, claude_sonnet_4_6, claude_opus_4_6, claude_opus_4_7,
# claude_opus_4_8, claude-sonnet-5. NOTE: plain "gpt_5" is NOT valid and returns HTTP 500.
LLM_MODEL=claude_opus_4_8

# Base44 (if LLM_PROVIDER=base44) — spends your Base44 credits
BASE44_FN_URL=
BASE44_SHARED_SECRET=

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Railway Postgres (auto in deploy; your own locally)
DATABASE_URL=

# Behaviour / versioning
CONF_THRESHOLD=0.7
LIBRARY_VERSION=v1
PROMPT_VERSION=v1
CORPUS_VERSION=v1
